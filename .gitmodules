[submodule "nvidia-oot"]
	url = https://github.com/apl-ocean-engineering/nvidia-oot
	path = nvidia-oot
[submodule "hwpm"]
	path = hwpm
	url = https://gitlab.com/nvidia/nv-tegra/linux-hwpm.git
[submodule "nvethernetrm"]
	path = nvethernetrm
	url = https://gitlab.com/nvidia/nv-tegra/kernel/nvethernetrm.git
[submodule "build/nvidia-public"]
	path = build/nvidia-public
	url = https://gitlab.com/nvidia/nv-tegra/kernel/build/nvidia-public.git
[submodule "hardware/nvidia/tegra/nvidia-public"]
	path = hardware/nvidia/tegra/nv-public
	url = https://gitlab.com/nvidia/nv-tegra/device/hardware/nvidia/tegra-public-dts.git
[submodule "hardware/nvidia/t23x/nvidia-public"]
	path = hardware/nvidia/t23x/nv-public
	url = https://github.com/apl-ocean-engineering/opal-nvidia-t23x-public-dts.git
[submodule "alvium-csi2-driver"]
	path = alvium-csi2-driver
	url = https://github.com/alliedvision/alvium-csi2-driver.git
